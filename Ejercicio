#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

float validarNota(string mensaje) {
    float nota;
    do {
        cout << mensaje;
        cin >> nota;
    } while (nota < 0 || nota > 10);
    return nota;
}

float validarAsistencia() {
    float asistencia;
    do {
        cout << "Porcentaje de Asistencia -> 0-100: ";
        cin >> asistencia;
    } while (asistencia < 0 || asistencia > 100);
    return asistencia;
}

char validarParalelo() {
    char paralelo;
    do {
        cout << "Paralelo -> A, B, C: ";
        cin >> paralelo;
        paralelo = toupper(paralelo);
    } while (paralelo != 'A' && paralelo != 'B' && paralelo != 'C');
    return paralelo;
}


float calcularPromedio(float nota1, float nota2, float practicas) {
    float prom;
    prom = (nota1 * 0.30) + (nota2 * 0.30) + (practicas * 0.40);
    return prom;
}

bool esEstable(float nota1, float nota2, float practicas) {
    bool estable;
    if (nota1 == nota2 && nota2 == practicas) {
        estable = true;
    } else {
        estable = false;
    }
    return estable;
}

bool esInestable(float nota1, float nota2, float practicas) {
    bool inestable;
    float notaMayor, notaMenor, diferencia;

    notaMayor = nota1;
    if (nota2 > notaMayor) {
        notaMayor = nota2;
    }
    if (practicas > notaMayor) {
        notaMayor = practicas;
    }

    notaMenor = nota1;
    if (nota2 < notaMenor) {
        notaMenor = nota2;
    }
    if (practicas < notaMenor) {
        notaMenor = practicas;
    }

    diferencia = notaMayor - notaMenor;
    if (diferencia > 4) {
        inestable = true;
    } else {
        inestable = false;
    }
    return inestable;
}

int main() {
    char repetirCurso, paralelo;
    string nombre, nombreMayor, nombreMenor;
    int N, i;
    float nota1, nota2, practicas, asistencia, promedio;

    int contA, contB, contC, contExc, contMuyB, contBno, contRiesgo;
    int contRepNota, contRepAsis, contAprobados, contEstable, contInestable;
    float sumaPromGeneral, sumaPromA, sumaPromB, sumaPromC;
    float promMayor, promMenor;

    do {
        contA = 0; contB = 0; contC = 0;
        contExc = 0; contMuyB = 0; contBno = 0; contRiesgo = 0;
        contRepNota = 0; contRepAsis = 0; contAprobados = 0;
        contEstable = 0; contInestable = 0;
        sumaPromGeneral = 0; sumaPromA = 0; sumaPromB = 0; sumaPromC = 0;
        promMayor = -1; promMenor = 11;
        nombreMayor = ""; nombreMenor = "";

        do {
            cout << "\nIngrese la cantidad de estudiantes a procesar -> N > 0: ";
            cin >> N;
        } while (N <= 0);

        for (i = 1; i <= N; i++) {
            cout << "\n====== DATOS DEL ESTUDIANTE " << i << " ======\n";
            cout << "Nombre: ";
            cin.ignore();
            getline(cin, nombre);

            paralelo = validarParalelo();
            nota1 = validarNota("Nota Primer Parcial (0-10): ");
            nota2 = validarNota("Nota Segundo Parcial (0-10): ");
            practicas = validarNota("Nota Practicas (0-10): ");
            asistencia = validarAsistencia();

            promedio = calcularPromedio(nota1, nota2, practicas);

            if (esEstable(nota1, nota2, practicas)) {
                cout << ">> Rendimiento estable detectado.\n";
                contEstable = contEstable + 1;
            }

            if (esInestable(nota1, nota2, practicas)) {
                cout << ">> Rendimiento inestable detectado.\n";
                contInestable = contInestable + 1;
            }

            if (paralelo == 'A') {
                contA = contA + 1;
                sumaPromA = sumaPromA + promedio;
            } else {
                if (paralelo == 'B') {
                    contB = contB + 1;
                    sumaPromB = sumaPromB + promedio;
                } else {
                    contC = contC + 1;
                    sumaPromC = sumaPromC + promedio;
                }
            }

            if (asistencia < 70) {
                cout << ">>Reprobado por asistencia.\n";
                contRepAsis = contRepAsis + 1;
            } else {
                if (promedio >= 9) {
                    cout << ">>Excelente.\n";
                    contExc = contExc + 1;
                    contAprobados = contAprobados + 1;
                    if (asistencia < 80) {
                        cout << ">>Inconsistencia -> Promedio alto, asistencia baja.\n";
                    }
                } else {
                    if (promedio >= 8) {
                        cout << ">>Muy bueno.\n";
                        contMuyB = contMuyB + 1;
                        contAprobados = contAprobados + 1;
                    } else {
                        if (promedio >= 7) {
                            cout << ">>Bueno.\n";
                            contBno = contBno + 1;
                            contAprobados = contAprobados + 1;
                        } else {
                            if (promedio >= 6) {
                                cout << ">>En riesgo.\n";
                                contRiesgo = contRiesgo + 1;
                                contAprobados = contAprobados + 1;
                            } else {
                                cout << ">>Reprobado por nota.\n";
                                contRepNota = contRepNota + 1;
                            }
                        }
                    }
                }
            }

            sumaPromGeneral = sumaPromGeneral + promedio;

            if (promedio > promMayor) {
                promMayor = promedio;
                nombreMayor = nombre;
            }
            if (promedio < promMenor) {
                promMenor = promedio;
                nombreMenor = nombre;
            }
        }

        cout << fixed << setprecision(2);
        cout << "\n====== REPORTE GENERAL ======\n";
        cout << "Total de estudiantes: " << N << "\n";
        cout << "Paralelo A: " << contA << " | B: " << contB << " | C: " << contC << "\n";
        cout << "Excelentes: " << contExc << " | Muy Buenos: " << contMuyB << " | Buenos: " << contBno << " | En riesgo: " << contRiesgo << "\n";
        cout << "Reprobados nota: " << contRepNota << " | Reprobados asistencia: " << contRepAsis << "\n";
        cout << "Promedio general: " << (sumaPromGeneral / N) << "\n";

        if (contA > 0) {
            cout << "Promedio Paralelo A: " << (sumaPromA / contA) << "\n";
        }
        if (contB > 0) {
            cout << "Promedio Paralelo B: " << (sumaPromB / contB) << "\n";
        }
        if (contC > 0) {
            cout << "Promedio Paralelo C: " << (sumaPromC / contC) << "\n";
        }

        cout << "Mayor promedio: " << promMayor << " (" << nombreMayor << ")\n";
        cout << "Menor promedio: " << promMenor << " (" << nombreMenor << ")\n";
        cout << "Aprobados: " << ((float)contAprobados * 100 / N) << "%\n";
        cout << "Estable: " << ((float)contEstable * 100 / N) << "% | Inestable: " << ((float)contInestable * 100 / N) << "%\n";
        cout << "=================================\n";

        cout << "Desea procesar otro curso? -> s/n: ";
        cin >> repetirCurso;

    } while (repetirCurso != 'n' && repetirCurso != 'N');

    cout << "Sistema finalizado.\n";

    return 0;
}

